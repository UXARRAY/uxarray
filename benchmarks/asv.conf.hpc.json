{
    // Thread-scaling variant of ``asv.conf.json``:
    //
    //     asv run --config benchmarks/asv.conf.hpc.json <range>
    //
    // A separate file, not a shell export, because asv folds ``env_nobuild``
    // into the environment name, keeping each thread count's results apart;
    // it also overrides any exported ``NUMBA_NUM_THREADS``.
    //
    // KEEP IN SYNC with asv.conf.json (``pythons``, ``environment_type``,
    // ``conda_channels``, ``matrix.req``, ``build_command``) or results
    // silently stop being comparable.

    "version": 1,
    "project": "uxarray",
    "project_url": "https://github.com/UXARRAY/uxarray",
    "repo": "..",
    "branches": ["main"],
    "dvcs": "git",
    "environment_type": "conda",
    "conda_channels": ["conda-forge"],
    "install_timeout": 600,
    "launch_method": "forkserver",
    "show_commit_url": "https://github.com/UXARRAY/uxarray/commit/",
    "pythons": ["3.11"],
    "benchmark_dir": ".",
    "build_command": [
        "python -mpip wheel --no-deps --no-build-isolation --no-index -w {build_cache_dir} {build_dir}"
    ],
    "build_cache_size": 4,

    // A parallel kernel at one thread runs ~core-count times longer.
    "default_benchmark_timeout": 1800,

    "matrix": {
        "req": {
            "setuptools_scm": [""],
            "xarray": [""],
            "netcdf4": [""],
            "pip+pyfma": [""],
            "tbb": [""]
        },

        // One value each: every value is a full pass over the suite, though
        // few benchmarks reach a ``parallel=True`` kernel. To sweep
        // ``NUMBA_NUM_THREADS``, see ``--env`` in ``helpers/_partition.py``.
        // BLAS is pinned so numba's threads are the only ones measured.
        "env_nobuild": {
            "NUMBA_THREADING_LAYER": ["forksafe"],
            "NUMBA_NUM_THREADS": ["8"],
            "OMP_NUM_THREADS": ["1"],
            "MKL_NUM_THREADS": ["1"],
            "OPENBLAS_NUM_THREADS": ["1"]
        }
    }
}
