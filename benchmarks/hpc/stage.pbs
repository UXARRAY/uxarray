#!/bin/bash
# The setup, shard and merge stages of a sharded asv run, selected by STAGE.
# Submitted by ``submit.sh`` (or run by ``local.sh``), not qsub'd by hand.
#
#PBS -N asv
#PBS -j oe
#PBS -l select=1:ncpus=128
#PBS -l walltime=12:00:00

set -euo pipefail

STAGE="${STAGE:?STAGE must be setup, shard or merge}"
SHARDS="${SHARDS:-4}"
REV="${REV:-HEAD^!}"
REPO="${REPO:?REPO must be the repository root}"
# Always set: numba's own default counts SMT siblings as cores. Applied through
# env_nobuild, so it lands in asv's environment name and thread counts do not
# overwrite each other's results.
THREADS="${THREADS:-8}"

eval "${ASV_ACTIVATE:-true}"
cd "$REPO/benchmarks"
# One machine name for all shards, or the merge has nothing to line up; see
# ``helpers/_machine.py``.
export ASV_MACHINE="${ASV_MACHINE:-$(cd .. && python -m benchmarks.helpers._machine --print)}"

case "$STAGE" in
setup)
    # Done once so concurrent shards do not race to build the shared
    # fixture cache, machine file and ``env/<hash>``.
    (cd .. && python -m benchmarks.helpers._fixtures)
    (cd .. && python -m benchmarks.helpers._machine)
    # Discovery only: builds the environments and benchmarks.json, runs
    # nothing. ``env_nobuild`` is not hashed into ``env/<hash>``, so one build
    # serves every thread count. ``-m`` because the machine file has the
    # pinned name, not this host's.
    asv run --bench just-discover -m "$ASV_MACHINE" "$REV"
    PYTHONPATH=.. python -m benchmarks.helpers._partition --shards "$SHARDS"
    ;;
shard)
    SHARD="${PBS_ARRAY_INDEX:-${SHARD:?}}"
    # Writes this shard's config (own results_dir, thread count) and prints
    # the asv arguments.
    ASV_ARGS=$(PYTHONPATH=.. python -m benchmarks.helpers._partition \
        --shards "$SHARDS" --shard "$SHARD" --env NUMBA_NUM_THREADS="$THREADS")
    status=0
    # A parallel kernel at one thread runs ~core-count times longer than at
    # eight, so allow more than CI's default timeout.
    asv run --show-stderr -m "$ASV_MACHINE" -a timeout=1800 $ASV_ARGS "$REV" || status=$?
    # 2 means some benchmarks failed; the rest are still worth merging.
    if [ "$status" -eq 2 ]; then
        echo "asv exited 2: some benchmarks failed, see above" >&2
    elif [ "$status" -ne 0 ]; then
        exit "$status"
    fi
    ;;
merge)
    (cd .. && python -m benchmarks.helpers._merge \
        --out benchmarks/results benchmarks/results.shard*)
    asv show -m "$ASV_MACHINE" || true
    ;;
*)
    echo "unknown STAGE $STAGE" >&2
    exit 2
    ;;
esac
